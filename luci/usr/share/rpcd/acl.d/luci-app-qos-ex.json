{
	"luci-app-qos-ex": {
		"description": "Grant access to the QoS-Ex / Ping Filter LuCI app",
		"read": {
			"file": {
				"/sys/class/net": [ "list" ]
			},
			"ubus": {
				"qos-ex":  [
					"status", "state", "stats", "counters", "live", "nfterr", "logdump",
					"ruleset", "conntrack",
					"pf_status", "pf_servers", "pf_telemetry",
					"pf_text", "pf_lists", "pf_sessions", "update_check", "update_log",
					"autosetup"
				],
				"luci-rpc": [ "getHostHints" ]
			},
			"uci":  [ "qos-ex" ]
		},
		"write": {
			"ubus": {
				"qos-ex":  [ "action", "pf_action", "pf_set_home", "pf_run", "update_run", "update_cfg", "update_branch", "uninstall_run", "cfg_import", "debug", "cfg_export", "autosetup_run" ]
			},
			"uci":  [ "qos-ex" ]
		}
	}
}
